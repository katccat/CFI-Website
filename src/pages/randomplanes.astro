---
import Base from '../layouts/Base.astro'
---
<Base
  title="Random Plane Generator"
  description="Discover real-world aircraft with the Random Plane Generator! Instantly explore planes from all eras, complete with images and facts. A fun tool for aviation enthusiasts, students, and pilots alike."
>
  <div id="content">
    <picture>
      <source media="(min-width: 450px)" srcset="/randomplanes/banner.png" />
      <source media="(max-width: 450px)" srcset="/randomplanes/banner_small.png" />
      <img src="/randomplanes/banner.png" class="banner-small" alt="Random Plane Generator" title="Generate a random, real world plane from any era." />
    </picture>
    <div id="interact-area">
      <button class="button auto" onclick="random_playne()">Which plane will choose you?</button>
      <input
        type="text"
        id="year"
        placeholder="Year: Any"
        title={"Year first flown\nDecades are available, e.g. '2010s'"}
      />
    </div>
    <br />
    <h3 class="push-left"><a id="name" target="_blank" class="uncolored-link"></a></h3>
    <span class="half-line-break"></span>
    <div id="container">
      <img id="image" />
      <p id="description"></p>
    </div>
  </div>
  <div style="display: none"><img src="/randomplanes/no_image.png" /></div>
  <script is:inline type="module" src="/randomplanes/planes2.js"></script>
</Base>

<style is:global>
  picture,
  img {
    user-select: none;
  }
  #year {
    width: 10ch;
  }
  #disclaimer {
    text-align: right;
    margin-left: auto;
    font-style: italic;
    font-size: 15px;
  }
  #container {
    align-content: flex-start;
    text-overflow: ellipsis;
    height: 800px;
    width: 100%;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 2vw;
  }
  #name {
    text-decoration: none;
    font-size: clamp(1vw, 25px, 5vw);
  }
  a#name {
    font-family: inherit;
  }
  #image {
    max-width: min(100%, 600px);
    height: 51vh;
    object-fit: cover;
    @media (max-width: 430px) {
      height: auto;
      object-fit: contain;
    }
  }
  #description {
    min-width: 25%;
    flex: 1 1;
    max-width: min(100%, 500px);
  }
  .mw-empty-elt {
    display: none;
  }
  .banner-cover {
    margin-left: 0;
  }
  #content {
    padding-left: 6vw;
    padding-right: 6vw;
  }
  #interact-area {
    overflow: hidden;
    align-items: center;
    justify-content: center;
    display: flex;
    flex-direction: row;
    width: 100%;
    flex-wrap: wrap;
    gap: 1vmax;
  }
  #interact-area button {
    min-width: 0;
    text-overflow: ellipsis;
  }
  #interact-area input {
    min-width: 0;
    flex-grow: 1;
    max-width: 100px;
  }
  .button,
  input {
    box-sizing: border-box;
    padding: 10px 14px 10px 14px;
    margin: 0;
  }
</style>
