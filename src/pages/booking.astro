---
import Base from '../layouts/Base.astro'
import Img from '../components/Img.astro'
import { SITE_NAME } from '../consts'
---
<Base title=`${SITE_NAME} | Book a Lesson`>
  <div id="content">
    <Img
      src="/images/bookalesson2.png"
      class="banner-cover"
      alt="Book a Lesson"
      title="Book a flight lesson in Daytona Beach"
    />
    <br />
    <div class="column-wrapper">
      <div class="cfi-info-div">
        <h1>Hourly Rate: $45</h1>
        <br />
        <h3>As a CFI, I Can Provide:</h3>
        <span class="half-line-break"></span>
        <ul>
          <li>Private, Commercial, Instrument, & CFI Training</li>
          <li>Discovery Flights – <b>flat rate of $94</b></li>
          <li>Written Endorsements</li>
          <li>Checkride Refreshers</li>
          <li>Instrument Proficiency Checks (IPC)</li>
          <li>Biannual Flight Reviews (BFR)</li>
        </ul>
        <br />
        <p>
          I can instruct you in any plane at <a href="https://airamericafc.com/our-fleet-rates/">Air America</a> or one
          of your own.
        </p>
      </div>
      <div id="slideshow-div">
        <div id="slideshow-container">
          <img
            id="slideshow"
            class="slideshow"
            src="/images/slides/1.png"
            alt="Pictures of my curriculum as a flight instructor"
            title="CFI curriculum"
          />
        </div>
        <div>
          <a class="button auto" href="/files/CFI Master Document.pdf">CFI Master Doc</a>
          <a class="button auto" href="https://docs.google.com/presentation/d/1CtG2n0A19DzMjTnrVpmdwDSfSQF1glJL6JA6Zm5_MH4/edit?slide=id.p#slide=id.p">Accelerated Flight Training</a>
        </div>
      </div>
    </div>

    <br /><br />

    <div class="column-wrapper card" id="get-in-touch">
      <div class="text-column">
        <div>
          <h1>Book a Lesson</h1>
          <br />
          <p>
            Want to book a lesson? Reach out to me at my email or phone so we can get started.
            <br /><br />
            Make an account on <a href="https://app.flightschedulepro.com/Account/Signup/186107">Flight Schedule Pro</a> so
            I can schedule the appointment with you.
            <br /><br />
            See you soon!
          </p>
          <span class="half-line-break"></span>
          <div id="contact-interact-wrapper">
            <button class="button auto" id="reveal-contact"></button>
            <div id="contact-text">
              <p>Email: emailto0000@gmail.com<br />Phone: (555)-555-5555</p>
            </div>
          </div>
        </div>
      </div>
      <Img
        src="/images/orangesky2.png"
        id="rainbow"
        alt="Plane Flying Against Sunset"
        title="Book a flight lesson now in Daytona Beach"
      />
    </div>
  </div>
  <script is:inline src="/script.js"></script>
  <script is:inline>
    const slideshow = document.getElementById("slideshow");
    const image_directory = "/images/slides/";
    const images = ["1.png", "2.png", "3.png", "4.png"];
    start_slide_show(slideshow, image_directory, images, 6000);
    const get_in_touch = document.getElementById("get-in-touch");
    window.onload = function () {
      if (is_portrait.matches) {
        get_in_touch.classList.remove("card");
      }
    };
    window.addEventListener("resize", function () {
      if (is_portrait.matches) {
        get_in_touch.classList.remove("card");
      } else {
        get_in_touch.classList.add("card");
      }
    });
  </script>
</Base>

<style is:global>
  .text-column {
    flex: 1 1 0;
  }
  .cfi-info-div {
    flex: 1 1 0;
    min-width: min(100%, 300px);
    align-self: flex-start;
  }
  img.slideshow {
    object-fit: contain;
  }
  #slideshow-div {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: min(100%, 450px);
    align-items: center;
    justify-items: center;
  }
  #slideshow-container {
    /*height: min(35rem, 44vmax);*/
    width: min(35rem, 100%);
    display: flex;
    flex-basis: 1;
    flex-direction: row;
    justify-content: flex-start;
    border: 1px solid;
    border-color: #333333;
  }
  #rainbow {
    width: 35rem;
    max-width: 100%;
    height: 28rem;
    object-fit: cover;
  }
  #get-in-touch.card {
    background-color: rgba(245, 245, 245, 0.65);
    padding-left: 20px;
  }
</style>
