---
import Base from '../layouts/Base.astro'
import Img from '../components/Img.astro'
import { SITE_NAME } from '../consts'
---
<Base title=`${SITE_NAME} | About`>
  <div id="content">
    <div class="column-wrapper" id="bio">
      <div class="text-column">
        <div>
          <h1>About Me</h1>
          <br />
          <p>
            I am an independent flight instructor, student at Embry-Riddle, Daytona, and most recently a seaplane pilot.
            When I was first flown up in a Cirrus SR22 and given the opportunity to steer it at a young age, I realized
            then and there that I wanted to dedicate myself to flying. By the time I was 18, I earned my Private Pilot
            License at the quaint Greenwood Lake Airport in New Jersey and went on to get my Commercial License a year
            later.
            <br /><br />
            I enjoy making art, with much of my paintings and illustrations being of birds, B-2s, and other aircraft! I
            also like to game, watch classic movies, and seek thrills in roller coasters, hang gliding, or even
            skydiving.
          </p>
          <span class="half-line-break"></span>
          <div class="align-center">
            <a class="button" href="https://www.instagram.com/damonwelber/">Instagram</a>
            <a class="button" href="https://www.linkedin.com/in/damon-welber-bbb23a2b5">Linkedin</a>
          </div>
        </div>
      </div>

      <div class="image-grid">
        <div class="left-column">
          <Img src="/images/selfies/peace.jpeg" />
        </div>
        <div class="right-column">
          <Img src="/images/selfies/headset.jpeg" />
          <Img src="/images/selfies/smiling.jpeg" />
        </div>
      </div>
    </div>
  </div>
</Base>

<style is:global>
  .image-grid {
    display: flex;
    width: min(100%, 600px);
    height: min(500px, 40vmax);
    gap: max(1vmin, 5px);
    justify-content: center;
  }
  .image-grid img {
    max-height: 100%;
    max-width: 100%;
    object-fit: cover;
    overflow: hidden;
  }
  .left-column {
    flex-basis: 50%;
    flex-grow: 1;
    height: 100%;
    min-width: min(205px, 50%);
  }
  .left-column img {
    width: 100%;
    height: 100%;
    object-position: right center;
  }
  .right-column {
    flex-basis: 50%;
    flex-grow: 1;
    height: 100%;
    min-width: min(145px, 50%);
    display: flex;
    gap: inherit;
    flex-direction: column;
  }
  .right-column img {
    width: 100%;
    height: 50%;
  }
  #bio {
    align-items: flex-start;
  }
</style>
